{
    "id": "system.clock",
    "name": "Clock",
    "publisher": "deetech",
    "version": 3,
    "permissions": [
        "ui.render",
        "time.read",
        "system.locale.read"
    ],
    "components": [
        {
            "id": "main",
            "type": "watchface",
            "role": "clock",
            "ui": [
                {
                    "kind": "rect",
                    "w": 280,
                    "h": 240,
                    "color": "theme.background"
                },
                {
                    "kind": "text",
                    "x": 140,
                    "y": 55,
                    "center": true,
                    "text": "${time.date}",
                    "color": "theme.muted"
                },
                {
                    "kind": "text",
                    "x": 140,
                    "y": 150,
                    "center": true,
                    "text": "${time.read}",
                    "font": 1,
                    "color": "theme.text"
                },
                {
                    "kind": "rounded",
                    "x": 272,
                    "y": 95,
                    "w": 3,
                    "h": 50,
                    "extra": 1,
                    "color": "theme.muted"
                }
            ]
        }
    ],
    "capabilities": 3,
    "icons": {
        "main": 100,
        "mask": 101
    },
    "resources": [
        {
            "id": 100,
            "path": "assets/clock.png",
            "format": "image",
            "representation": "INDEX8"
        },
        {
            "id": 101,
            "path": "assets/clock-mask.png",
            "format": "image",
            "representation": "A4",
            "mask": "alpha"
        }
    ]
}
