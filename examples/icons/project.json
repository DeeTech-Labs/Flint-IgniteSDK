{
    "id": "example.icons",
    "name": "Icon resources",
    "publisher": "deetech",
    "version": 1,
    "permissions": ["ui.render", "ui.resources"],
    "capabilities": 3,
    "icons": {"main": 100, "mask": 101, "light": 102, "dark": 103},
