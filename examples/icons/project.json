    "components": [{"id": "main", "type": "app", "ui": [
        {"kind": "rect", "w": 280, "h": 240, "color": "theme.background"},
        {"kind": "text", "x": 140, "y": 42, "center": true, "text": "FLIM v2", "color": "theme.text"},
        {"kind": "image", "x": 40, "y": 76, "w": 48, "h": 48, "resource": 100},
        {"kind": "image", "x": 116, "y": 76, "w": 48, "h": 48, "resource": 101, "color": "theme.accent"},
        {"kind": "image", "x": 192, "y": 76, "w": 48, "h": 48, "resource": 103},
        {"kind": "text", "x": 140, "y": 168, "center": true, "text": "INDEX8 / A4 / RGB+A", "color": "theme.text"}
    ]}]
}
