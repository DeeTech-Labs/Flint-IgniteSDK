# Shared generation entry point for host SDK builds and ESP-IDF consumers.
function(flint_generate_sdk)
    cmake_parse_arguments(GEN "EXAMPLES" "OUTPUT_DIR" "" ${ARGN})
    if(NOT GEN_OUTPUT_DIR OR GEN_UNPARSED_ARGUMENTS)
        message(FATAL_ERROR "flint_generate_sdk requires OUTPUT_DIR and optional EXAMPLES")
    endif()
    get_filename_component(_sdk "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/.." ABSOLUTE)
    get_filename_component(_output "${GEN_OUTPUT_DIR}" ABSOLUTE BASE_DIR "${CMAKE_CURRENT_BINARY_DIR}")
    find_package(Python3 COMPONENTS Interpreter REQUIRED)
    file(GLOB_RECURSE _inputs CONFIGURE_DEPENDS
        "${_sdk}/spec/*.json" "${_sdk}/system/*" "${_sdk}/tools/*.py")
    if(GEN_EXAMPLES)
        file(GLOB_RECURSE _example_inputs CONFIGURE_DEPENDS "${_sdk}/examples/*")
        list(FILTER _example_inputs EXCLUDE REGEX "(/__pycache__/|\\.pyc$|/sample\\.ignit$)")
        list(APPEND _inputs ${_example_inputs})
    endif()
    set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS ${_inputs})
    execute_process(COMMAND "${Python3_EXECUTABLE}" -B "${_sdk}/tools/generate_registry.py"
        --output "${_output}/include" RESULT_VARIABLE _result)
    if(NOT _result EQUAL 0)
        message(FATAL_ERROR "IgniteSDK registry generation failed")
    endif()
    if(GEN_EXAMPLES)
        set(_examples --examples-output "${_output}/examples")
    else()
        set(_examples --skip-examples)
    endif()
    execute_process(COMMAND "${Python3_EXECUTABLE}" -B "${_sdk}/tools/build_system.py"
        --output "${_output}/factory" ${_examples} RESULT_VARIABLE _result)
    if(NOT _result EQUAL 0)
        message(FATAL_ERROR "IgniteSDK package generation failed")
    endif()
    set(FLINT_GENERATED_INCLUDE_DIR "${_output}/include" PARENT_SCOPE)
    set(FLINT_FACTORY_DIR "${_output}/factory" PARENT_SCOPE)
    set(FLINT_EXAMPLES_DIR "${_output}/examples" PARENT_SCOPE)
endfunction()
